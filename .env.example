# Environment configuration template
# Copy to .env and fill in your values

# Hermes Web UI authentication token
AUTH_TOKEN=$(cat ~/.hermes-web-ui/.token)

# xAI Grok API key (optional, if using OAuth skip this)
# XAI_API_KEY=your_xai_token_here

# MiniMax API key (optional alternative)
# MINIMAX_API_KEY=your_minimax_key_here

# Hermes Web UI base URL (default: http://127.0.0.1:8648)
HERMES_WEB_UI_URL=http://127.0.0.1:8648
